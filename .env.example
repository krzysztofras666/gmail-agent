OPENAI_API_KEY=sk-...

# Set to 0 to stop scheduled runs and block `travel_agent send` (see scripts/disable_agent.sh)
# TRAVEL_AGENT_ENABLED=1
# TRAVEL_EMAIL_ENABLED=1

# Optional overrides
# OPENAI_MODEL=gpt-4o-mini
# TRAVEL_OPENAI_MODEL=gpt-4o-mini
# TRAVEL_HTTP_TIMEOUT=20
# TRAVEL_FETCH_CONCURRENCY=6
# TRAVEL_MAX_TEXT_CHARS=18000
# TRAVEL_MAX_OFFERS_PER_DEST=3
# TRAVEL_BROWSER_RETRY_MIN_CHARS=2000

# Email (needs Gmail OAuth token from gmail-agent)
# TRAVEL_EMAIL_FROM=andalath@gmail.com
# TRAVEL_EMAIL_TO=andalath@gmail.com,katarzyna.dyngosz@gmail.com,goniaras@gmail.com
# Gmail OAuth token directory (see gmail-agent auth)
# GMAIL_TOKEN_DIR=~/.config/gmail-agent
# Common locations checked automatically:
#   ~/.config/gmail-agent/<email>/token.json
#   ~/gmail-agent/accounts/<email>/token.json

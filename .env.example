OPENAI_API_KEY=sk-...

# Optional overrides
# OPENAI_MODEL=gpt-4o-mini
# TECH_NEWS_OPENAI_MODEL=gpt-4o-mini
# TECH_NEWS_HTTP_TIMEOUT=20
# TECH_NEWS_FETCH_CONCURRENCY=6
# TECH_NEWS_MAX_TEXT_CHARS=18000
# TECH_NEWS_MAX_ARTICLES=30
# TECH_NEWS_MAX_PER_TOPIC=5
# TECH_NEWS_HOURS_LOOKBACK=48
# TECH_NEWS_HN_TOP_STORIES=25

# Email (optional — needs Gmail OAuth token from gmail-agent)
# TECH_NEWS_EMAIL_FROM=you@gmail.com
# TECH_NEWS_EMAIL_TO=you@gmail.com,friend@example.com
# GMAIL_TOKEN_DIR=~/.config/gmail-agent

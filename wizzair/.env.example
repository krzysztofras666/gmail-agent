WIZZAIR_EMAIL=you@example.com
WIZZAIR_PASSWORD=your-password-here

# Email digest (needs Gmail OAuth token from gmail-agent)
# WIZZAIR_EMAIL_FROM=andalath@gmail.com
# WIZZAIR_EMAIL_TO=katarzyna.dyngosz@gmail.com,andalath@gmail.com
# GMAIL_TOKEN_DIR=~/.config/gmail-agent
# Default search also checks ~/gmail-agent/accounts/<email>/token.json

# Set to 0 to stop scheduled runs and block wizzair send (see ../scripts/disable_agent.sh)
# WIZZAIR_AGENT_ENABLED=1
# WIZZAIR_EMAIL_ENABLED=1

# Optional overrides
# WIZZAIR_PASS_ID=9894166c-1b7b-4f3a-89fc-1f6180fa5878
# WIZZAIR_ORIGINS=KRK,KTW
# WIZZAIR_DAYS=4
# WIZZAIR_DESTINATIONS=FCO,BCN,LTN   # opcjonalny filtr — skróca skan
# WIZZAIR_FAST_SCAN=true             # krótsze timeouty UI (~40% szybciej)
# WIZZAIR_HTTP_TIMEOUT=60
# WIZZAIR_SEARCH_CONCURRENCY=4
# WIZZAIR_HEADLESS=true
# WIZZAIR_USE_CHROME=true
# WIZZAIR_STORAGE_STATE=~/.config/wizzair/storage_state.json
